# ===== OpenClaw 网关 =====
# 控制界面的访问令牌，自己生成一串随机值，例如：openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-random-long-string
OPENCLAW_GATEWAY_PORT=18789

# 容器与定时任务统一用北京时间，保证早晚 7:30 准点
TZ=Asia/Shanghai

# ===== 模型 API Key（用哪家填哪家，其余留空）=====
# 智谱 GLM：https://open.bigmodel.cn 或 https://z.ai
ZAI_API_KEY=
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# OpenAI（如用官方/代理）
OPENAI_API_KEY=

# ===== 火山引擎 Ark（模型对话 + 文生图封面 gen_cover.mjs）=====
# https://console.volcengine.com/ark
ARK_API_KEY=

# ===== 联网搜索（web_search：Tavily 优先，额度尽切 Brave）=====
# Tavily: https://app.tavily.com（免费档 1000 次/月）
TAVILY_API_KEY=
# Brave: https://brave.com/search/api（免费档 2000 次/月）
BRAVE_API_KEY=

# ===== 微信公众号（mp.weixin.qq.com → 设置与开发 → 基本配置）=====
# 服务器公网 IP 必须先加入同一页面的「IP 白名单」，否则拿不到 access_token
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
